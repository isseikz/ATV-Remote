# Environment Configuration for Remote APK Installation System

# Firebase Configuration
# Path to Firebase service account JSON file for FCM Admin SDK
FCM_SERVICE_ACCOUNT_PATH=/path/to/firebase-service-account.json

# AWS Configuration
# AWS region where S3 bucket is located
AWS_REGION=us-east-1
# AWS credentials for S3 access (alternatively use AWS CLI configuration)
AWS_ACCESS_KEY_ID=your_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here

# S3 Bucket Configuration
# S3 bucket name for storing APK files
S3_BUCKET=your-apk-bucket-name

# Backend Server Configuration
# Server host and port (for demo server)
SERVER_DOMAIN=0.0.0.0
SERVER_PORT=8080

# Optional: API Authentication
# Token for authenticating CI/CD webhook requests
BACKEND_API_TOKEN=your_secure_api_token_here
